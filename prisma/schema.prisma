generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────

enum StatusAktif {
  AKTIF
  NONAKTIF
}

enum TipePegawai {
  PNS
  ASN
  OUTSOURCING
  TA
}

enum TaKategori {
  BIASA
  RO
}

enum StatusRo {
  AKTIF
  NONAKTIF
  SELESAI
}

enum TipeUnit {
  KOORDINATOR
  SUB_KOORDINATOR
}

enum SumberDana {
  RO
  OPERASIONAL
}

enum StatusAlokasi {
  AKTIF
  DIBATALKAN
}

enum StatusRekonsiliasi {
  MATCHED
  UNMATCHED
}

enum AksiAudit {
  CREATE
  UPDATE
  DELETE
  ACTIVATE
  CANCEL
}

enum KategoriKamar {
  P1_PNS_NON_PNS   // 48% (Kepegawaian/Umum)
  P2_KP3           // 30% (KP3)
  OPS_KANTOR       // 17% (Bagian Umum)
  OPS_KP3          // 2.5% (KP3)
  MULOS_SPI        // 2.5% (SPI)
  LAINNYA
}

// ─── 1. AUTH / USER ────────────────────────────────────────────────────────

model Role {
  id        String  @id @default(uuid()) @db.Uuid
  kode      String  @unique @db.VarChar(50)
  nama      String  @db.VarChar(100)
  deskripsi String? @db.Text

  users     User[]
  userRoles UserRole[]

  @@map("role")
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  nama          String      @db.VarChar(150)
  email         String      @unique @db.VarChar(150)
  password_hash String      @db.VarChar(255)
  foto          String?     @db.VarChar(500)
  role_id       String      @db.Uuid
  // Untuk user KOORDINATOR: unit kerja yang dipimpin
  unit_kerja_id String?     @db.Uuid
  pegawai_id    String?     @unique @db.Uuid
  status        StatusAktif @default(AKTIF)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  created_by    String?     @db.Uuid

  role        Role       @relation(fields: [role_id], references: [id])
  pegawai     Pegawai?   @relation(fields: [pegawai_id], references: [id])
  unit_kerja  UnitKerja? @relation(fields: [unit_kerja_id], references: [id])

  userRoles                 UserRole[]
  alokasi_dibuat            AlokasiGajiTA[]
  audit_log                 AuditLog[]
  rekonsiliasi_diperiksa    RekonsiliasiBank[]

  @@index([role_id])
  @@map("user")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  role_id    String   @db.Uuid
  is_default Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@index([user_id])
  @@map("user_role")
}

// ─── 2. ORGANISASI ─────────────────────────────────────────────────────────

model UnitKerja {
  id              String      @id @default(uuid()) @db.Uuid
  kode_unit       String      @unique @db.VarChar(30)
  nama_unit       String      @db.VarChar(150)
  tipe_unit       TipeUnit
  parent_unit_id  String?     @db.Uuid
  kepala_unit_id  String?     @db.Uuid
  deskripsi       String?     @db.Text
  status_aktif    StatusAktif @default(AKTIF)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  parent   UnitKerja?  @relation("UnitHierarki", fields: [parent_unit_id], references: [id])
  children UnitKerja[] @relation("UnitHierarki")

  kepala_unit Pegawai? @relation("KepalaUnit", fields: [kepala_unit_id], references: [id])

  sk_list          Sk[]
  ro_list          Ro[]
  dana_operasional DanaOperasional[]
  user_koordinator User[]
  pengaturan_margin_list PengaturanMargin[]

  @@index([parent_unit_id])
  @@index([tipe_unit])
  @@map("unit_kerja")
}

// ─── 3. PEGAWAI ────────────────────────────────────────────────────────────

model Pegawai {
  id            String      @id @default(uuid()) @db.Uuid
  nip_nik       String      @unique @db.VarChar(32)
  nama          String      @db.VarChar(150)
  tipe_pegawai  TipePegawai
  jabatan       String?     @db.VarChar(150)
  email         String?     @unique @db.VarChar(150)
  telepon       String?     @db.VarChar(30)
  tanggal_mulai DateTime    @db.Date
  status_aktif  StatusAktif @default(AKTIF)

  // Khusus TA
  bidang_keahlian String?    @db.VarChar(150)
  kontrak_mulai   DateTime?  @db.Date
  kontrak_selesai DateTime?  @db.Date
  ta_kategori     TaKategori @default(BIASA)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  kepala_dari UnitKerja[] @relation("KepalaUnit")

  sk_list         Sk[]
  alokasi_list    AlokasiGajiTA[]
  user_akun       User?

  @@index([tipe_pegawai])
  @@index([status_aktif])
  @@map("pegawai")
}

// ─── 4. SK (SURAT KEPUTUSAN PENUGASAN — Single Source of Truth) ────────────

model Sk {
  id              String      @id @default(uuid()) @db.Uuid
  nomor_sk        String      @unique @db.VarChar(100)
  tanggal_sk      DateTime    @db.Date
  tanggal_efektif DateTime    @db.Date
  tanggal_selesai DateTime?   @db.Date
  pegawai_id      String      @db.Uuid
  unit_kerja_id   String      @db.Uuid
  jabatan         String?     @db.VarChar(150)
  file_sk         String?     @db.VarChar(500)
  gaji_bulanan    Int         @default(0)
  sumber_dana_default         SumberDana? @default(OPERASIONAL)
  ro_id_default               String?     @db.Uuid
  dana_operasional_id_default String?     @db.Uuid
  is_homebase     Boolean     @default(true)
  keterangan      String?     @db.VarChar(255)
  status_aktif    StatusAktif @default(AKTIF)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  pegawai     Pegawai         @relation(fields: [pegawai_id], references: [id])
  unit_kerja  UnitKerja       @relation(fields: [unit_kerja_id], references: [id])
  ro_default  Ro?             @relation("SkRoDefault", fields: [ro_id_default], references: [id])
  dana_default DanaOperasional? @relation("SkDanaDefault", fields: [dana_operasional_id_default], references: [id])

  @@index([pegawai_id])
  @@index([status_aktif])
  @@index([is_homebase])
  @@index([tanggal_selesai])
  @@map("sk")
}

// ─── 5. PROYEK & RO ────────────────────────────────────────────────────────

model MasterRekening {
  id              String      @id @default(uuid()) @db.Uuid
  nama_bank       String      @db.VarChar(100)
  nomor_rekening  String      @unique @db.VarChar(100)
  nama_rekening   String      @db.VarChar(200)
  status_aktif    StatusAktif @default(AKTIF)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  ro_list                 Ro[]
  dana_operasional_list   DanaOperasional[]
  pengaturan_margin_list  PengaturanMargin[]
  rekonsiliasi_list        RekonsiliasiBank[]

  @@index([status_aktif])
  @@map("master_rekening")
}

model RekonsiliasiBank {
  id                    String              @id @default(uuid()) @db.Uuid
  rekening_id            String              @db.Uuid
  tanggal_rekonsiliasi   DateTime            @db.Date
  tahun_fiscal           Int
  saldo_sistem           Int
  saldo_bank             Int
  selisih                Int
  status                 StatusRekonsiliasi
  keterangan             String?             @db.VarChar(500)
  diperiksa_oleh         String              @db.Uuid
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt

  rekening  MasterRekening @relation(fields: [rekening_id], references: [id])
  pemeriksa User           @relation(fields: [diperiksa_oleh], references: [id])

  @@unique([rekening_id, tanggal_rekonsiliasi])
  @@index([tahun_fiscal])
  @@index([tanggal_rekonsiliasi])
  @@index([diperiksa_oleh])
  @@map("rekonsiliasi_bank")
}

model Proyek {
  id                String   @id @default(uuid()) @db.Uuid
  kode_proyek       String   @unique @db.VarChar(50)
  nama_proyek       String   @db.VarChar(200)
  tahun_fiscal      Int
  sumber_pendanaan  String?  @db.VarChar(150)
  nilai_kontrak     Int      @default(0)
  total_direct_cost Int      @default(0)
  total_margin      Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  ro_list              Ro[]
  dana_transaksi_list  DanaTransaksi[]

  @@index([tahun_fiscal])
  @@map("proyek")
}

model PengaturanMargin {
  id            String       @id @default(uuid()) @db.Uuid
  kategori_kamar KategoriKamar @unique
  nama_kamar    String       @db.VarChar(150)
  persentase    Float
  unit_kerja_id String       @db.Uuid
  rekening_id   String?      @db.Uuid
  updated_at    DateTime     @updatedAt

  unit_kerja UnitKerja        @relation(fields: [unit_kerja_id], references: [id])
  rekening   MasterRekening?  @relation(fields: [rekening_id], references: [id])

  @@index([unit_kerja_id])
  @@index([rekening_id])
  @@map("pengaturan_margin")
}

model Ro {
  id                  String   @id @default(uuid()) @db.Uuid
  kode_ro             String   @unique @db.VarChar(50)
  nama_ro             String   @db.VarChar(200)
  proyek_id           String   @db.Uuid
  unit_koordinator_id String   @db.Uuid
  rekening_id         String?  @db.Uuid
  tahun_fiscal        Int
  total_plafon        Int      @default(0)
  no_kontrak          String?  @db.VarChar(100)
  pj                  String?  @db.VarChar(150)
  file_rab            String?  @db.VarChar(500)
  file_sk             String?  @db.VarChar(500)
  status_ro           StatusRo @default(AKTIF)
  no_sk               String?  @db.VarChar(100)
  mulai_sk            DateTime? @db.Date
  berakhir_sk         DateTime? @db.Date
  parent_ro_id       String?  @db.Uuid
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  proyek           Proyek          @relation(fields: [proyek_id], references: [id])
  unit_koordinator UnitKerja       @relation(fields: [unit_koordinator_id], references: [id])
  rekening         MasterRekening? @relation(fields: [rekening_id], references: [id])
  parent_ro        Ro?             @relation("RoCarryover", fields: [parent_ro_id], references: [id])
  child_ro         Ro?             @relation("RoCarryover")

  alokasi_list   AlokasiGajiTA[]
  transaksi_list RoTransaksi[]
  sk_default_list Sk[] @relation("SkRoDefault")

  @@unique([parent_ro_id])
  @@index([proyek_id])
  @@index([unit_koordinator_id])
  @@index([tahun_fiscal])
  @@map("ro")
}

model RoTransaksi {
  id            String   @id @default(uuid()) @db.Uuid
  ro_id         String   @db.Uuid
  nama_kegiatan String   @db.VarChar(200)
  no_kuitansi   String?  @db.VarChar(100)
  tanggal       DateTime @db.Date
  debit         Int      @default(0)
  kredit        Int      @default(0)
  keterangan    String?  @db.VarChar(255)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  ro Ro @relation(fields: [ro_id], references: [id], onDelete: Cascade)

  @@index([ro_id])
  @@index([tanggal])
  @@map("ro_transaksi")
}

// ─── 6. DANA OPERASIONAL KOORDINATOR ───────────────────────────────────────

model DanaOperasional {
  id                  String   @id @default(uuid()) @db.Uuid
  unit_koordinator_id String   @db.Uuid
  rekening_id         String?  @db.Uuid
  tahun_fiscal        Int
  total_plafon        Int      @default(0)
  // NEW FIELD – kategori_kamar
  kategori_kamar   KategoriKamar @default(LAINNYA)

  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  unit_koordinator UnitKerja       @relation(fields: [unit_koordinator_id], references: [id])
  rekening         MasterRekening? @relation(fields: [rekening_id], references: [id])

  alokasi_list     AlokasiGajiTA[]
  transaksi_list   DanaTransaksi[]
  sk_default_list  Sk[] @relation("SkDanaDefault")

  @@unique([unit_koordinator_id, tahun_fiscal, kategori_kamar])
  @@map("dana_operasional")
}

model DanaTransaksi {
  id            String   @id @default(uuid()) @db.Uuid
  dana_id       String   @db.Uuid
  proyek_id     String?  @db.Uuid
  nama_kegiatan String   @db.VarChar(200)
  no_kuitansi   String?  @db.VarChar(100)
  tanggal       DateTime @db.Date
  debit         Int      @default(0)
  kredit        Int      @default(0)
  keterangan    String?  @db.VarChar(255)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  dana   DanaOperasional @relation(fields: [dana_id], references: [id], onDelete: Cascade)
  proyek Proyek?         @relation(fields: [proyek_id], references: [id], onDelete: SetNull)

  @@index([dana_id])
  @@index([proyek_id])
  @@index([tanggal])
  @@map("dana_transaksi")
}

// ─── 7. ALOKASI GAJI TA ────────────────────────────────────────────────────

model AlokasiGajiTA {
  id                  String        @id @default(uuid()) @db.Uuid
  pegawai_id          String        @db.Uuid
  periode_bulan       Int
  periode_tahun       Int
  sumber_dana         SumberDana
  ro_id               String?       @db.Uuid
  dana_operasional_id String?       @db.Uuid
  jumlah              Int
  status              StatusAlokasi @default(AKTIF)
  keterangan          String?       @db.VarChar(255)
  dibuat_oleh         String        @db.Uuid
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  pegawai          Pegawai          @relation(fields: [pegawai_id], references: [id])
  ro               Ro?              @relation(fields: [ro_id], references: [id])
  dana_operasional DanaOperasional? @relation(fields: [dana_operasional_id], references: [id])
  pembuat          User             @relation(fields: [dibuat_oleh], references: [id])

  @@index([pegawai_id])
  @@index([periode_bulan, periode_tahun])
  @@index([ro_id])
  @@index([dana_operasional_id])
  @@map("alokasi_gaji_ta")
}

// ─── 8. AUDIT TRAIL ────────────────────────────────────────────────────────

model AuditLog {
  id             String     @id @default(uuid()) @db.Uuid
  tabel          String     @db.VarChar(50)
  record_id      String     @db.Uuid
  aksi           AksiAudit
  dilakukan_oleh String     @db.Uuid
  data_sebelum   Json?
  data_sesudah   Json?
  created_at     DateTime   @default(now())

  pembuat User @relation(fields: [dilakukan_oleh], references: [id])

  @@index([tabel, record_id])
  @@map("audit_log")
}
